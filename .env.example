# Optional private receipt/cache location. It must resolve outside this source
# tree and is created with owner-only permissions. When unset, Blawx uses the
# operating system's per-user application-data directory.
BLAWX_PRIVATE_DATA_DIR=

# Live provider utilities are disabled unless their documented CLI opt-in flag
# is supplied. Credentials remain server-side and are never loaded into Vite.
OPENAI_API_KEY=
HF_TOKEN=
