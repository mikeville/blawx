# Private agent and project working material. These files belong outside any
# eventual public repository; ignoring them is only a guard for new files.
# .gitignore cannot protect a matching file that is already tracked.
AGENTS.md
AGENTS-HISTORY.md
SESSION.md
CLAUDE.md
MONITORING.md
.cursorrules
.impeccable.md
PRIVATE-*.md
*-PRIVATE.md
RELEASE-PLAN.md
PUBLISHING-DECISION.md
REDACTION-REPORT.md
*BILLING*.md
*RESEARCH*.md
*RECEIPT*.md
*.record.json
*.receipt.json
raw-records/
receipts/

# Runtime receipts belong in the OS data directory configured by
# BLAWX_PRIVATE_DATA_DIR, never in this repository. Ignore these legacy names
# only as a last-resort defense; the runtime also rejects in-tree roots.
artifacts/
experiments/

# Plans, proposals, research, and agent handoffs are private by default.
# Create them under .blawx-private/plans/; public usage/API docs are separate.
# Never force-add planning files. Ignore rules do not erase tracked history.
plans/
planning/
specs/
*PLAN*.md
*plan*.md
*SPEC*.md
*spec*.md
*BRIEF*.md
*brief*.md
*HANDOFF*.md
*handoff*.md
*ROADMAP*.md
